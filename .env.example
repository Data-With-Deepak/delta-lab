# Copy this file to ".env" and fill in your real keys.
# .env is gitignored — never commit real keys.

# Which environment to hit:
#   prod    -> https://api.india.delta.exchange   (real account / real money)
#   testnet -> https://cdn-ind.testnet.deltaex.org (demo account, fake funds)
DELTA_ENV=prod

# Trading API keys (from Delta India -> Account -> API Keys)
DELTA_API_KEY=
DELTA_API_SECRET=

# Telegram alerts (optional) — from @BotFather. Chat ID auto-detected if blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
